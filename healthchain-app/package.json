{
  "name": "healthchain-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "chain:dev": "hardhat node",
    "backend:bootstrap:safe": "wait-on tcp:127.0.0.1:8545 && cd ../healthchain-backend && npm run bootstrap:safe",
    "dev:full": "concurrently --names chain,backend,frontend --prefix-colors yellow,cyan,magenta \"npm run chain:dev\" \"npm run backend:bootstrap:safe\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "hardhat run --network localhost blockchain/scripts/deploy-and-update-env.ts",
    "preflight:contract": "hardhat run --network localhost blockchain/scripts/contracts-preflight-check.ts",
    "deploy:safe": "npm run deploy && npm run preflight:contract"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@veramo/credential-w3c": "^6.0.0",
    "@veramo/did-provider-ethr": "^6.0.0",
    "@veramo/did-provider-key": "^6.0.0",
    "@veramo/did-resolver": "^6.0.0",
    "@veramo/kms-local": "^6.0.0",
    "axios": "^1.13.6",
    "firebase": "^12.6.0",
    "html5-qrcode": "^2.3.8",
    "ipfs-http-client": "^60.0.1",
    "lucide-react": "^0.554.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.5",
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.3",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "chai": "^5.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "globals": "^16.5.0",
    "hardhat": "^3.1.10",
    "mocha": "^11.7.5",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^8.0.5"
  }
}
